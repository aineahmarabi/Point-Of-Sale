# Convex deployment (used by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-convex-domain # team: your_team, project: your_project
CONVEX_URL=https://your-convex-domain.convex.cloud
CONVEX_SITE_URL=https://your-convex-domain.convex.site

# Clerk (JWT issuer for Convex auth)
CLERK_ISSUER_URL=https://your-clerk-domain.clerk.accounts.dev

# Clerk webhook (set in Convex dashboard environment variables)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret
